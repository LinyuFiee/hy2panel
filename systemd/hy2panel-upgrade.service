[Unit]
Description=Download and apply a verified hy2panel update
Wants=network-online.target
After=network-online.target hy2panel-recover.service
Wants=hy2panel-recover.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/hy2panel-upgrade
TimeoutStartSec=600s
PrivateTmp=true
ProtectHome=true